# Copy this file to ".env" and set VITE_API_BASE_URL to the backend's
# actual reachable address.
#
# - Testing only on THIS machine:              http://localhost:8080/api
# - Testing from OTHER devices on your Wi-Fi:  http://<this-PC-LAN-IP>:8080/api
#   Find your LAN IP with:  Windows -> ipconfig (look for IPv4 Address)
#                            Mac/Linux -> ifconfig or `ip addr`
#   Example:  VITE_API_BASE_URL=http://192.168.1.5:8080/api
VITE_API_BASE_URL=http://localhost:8080/api
